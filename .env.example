NEXT_PUBLIC_BLOCKBOOK_API_URL=https://18.135.58.84:9140/api/v2
NEXT_PUBLIC_BLOCKBOOK_WS_URL=wss://18.135.58.84:9140/websocket
NEXT_PUBLIC_COIN_NAME=Bitcoin Genesis 1
NEXT_PUBLIC_COIN_SYMBOL=BTC1
NEXT_PUBLIC_EXPLORER_TITLE=BTC1 Explorer

# Server-only (never sent to the browser).
# Allows the self-signed cert on the Blockbook host ONLY. Must be false/unset in production.
BLOCKBOOK_ALLOW_SELF_SIGNED=true
# Outbound request budget toward Blockbook (it rate-limits per IP: ~20 burst, ~0.5-1 req/s).
BLOCKBOOK_RATE_PER_SEC=0.8
BLOCKBOOK_BURST=12
